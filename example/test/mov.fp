## MOV	(R1, C)
MOV AL 0x01
MOV AH 0x02
MOV BL 0x03
MOV BH 0x04
MOV CL 0x05
MOV CH 0x06
MOV DL 0x07
MOV DH 0x08

## MOV	(R2, C)
MOV	RAX	0x0807
MOV	RBX	0x0605
MOV	RCX	0x0403
MOV	RDX	0x0201

## MOV	(A, R1)
MOV	AL	0xff
MOV	BL	0xfe
MOV	CL	0xfd
MOV	DL	0xfc

MOV	@0x1000 AL
MOV	@0x1001 BL
MOV	@0x1002 CL
MOV	@0x1003 DL

## MOV	(R1, A)
MOV	@0x1000 0xf1
MOV	@0x1001 0xf2
MOV	@0x1002 0xf3
MOV	@0x1003 0xf4
MOV	@0x1004 0xf5
MOV	@0x1005 0xf6
MOV	@0x1006 0xf7
MOV	@0x1007 0xf8

MOV	AL		@0x1000
MOV	AH		@0x1001
MOV	BL		@0x1002
MOV	BH		@0x1003
MOV	CL		@0x1004
MOV	CH		@0x1005
MOV	DL		@0x1006
MOV	DH		@0x1007

## MOV	(A, C)
MOV	@0x1000 0x01
MOV	@0x1001 0x02
MOV	@0x1002 0x03
MOV	@0x1003 0x04

## MOV	(@R2, C)
MOV RAX	0x1000

MOV	@RAX 0x01

## MOV	(@R2, A)
MOV RAX	0x1001
MOV @0x1002	0x02

MOV	@RAX @0x1002

## MOV	(@R2, @R2)
MOV	RAX	0x1003
MOV	RBX	0x1004
MOV	@0x1004 0x02

MOV	@RAX @RBX


HLT
