## ADD	(R1, C)
MOV	AL	0b0001

ADD	AL	0b0010

## ADD	(R1, A)
MOV	@0x1000 0b0010
MOV	AL		0b0001

ADD AL		@0x1000

## ADD	(A, C)
MOV	@0x1000 0b0011

ADD	@0x1000 0b0001

## ADD	(A, R1)
MOV	@0x1000 1
MOV	AL		2

ADD @0x1000 AL

## ADD	(R1, R1)
MOV	AL	0x01
MOV	AH	0x11

ADD	AL	AH

## ADD	(A, A)
MOV	@0x1000	0x01
MOV	@0x1001	0x12

ADD	@0x1000 @0x1001

HLT