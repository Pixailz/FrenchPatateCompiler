## 0x1e	XOR	(R1, C)
MOV	AL	0b0011

XOR	AL	0b0110

## 0x1f	XOR	(R1, A)
MOV	@0x1000 0b0010
MOV	AL		0b0001

XOR AL		@0x1000

## 0x20	XOR	(A, C)
MOV	@0x1000 0b0011

XOR	@0x1000 0b0001

## 0x21	XOR	(A, R1)
MOV	@0x1000 1
MOV	AL		2

XOR @0x1000 AL

## 0x22	XOR	(R1, R1)
MOV	AL	0x11
MOV	AH	0x01

XOR	AL	AH

## 0x23	XOR	(A, A)
MOV	@0x1000	0x12
MOV	@0x1001	0x01

XOR	@0x1000 @0x1001

HLT