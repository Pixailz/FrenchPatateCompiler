## SUB	(R1, C)
MOV	AL	0b0001

SUB	AL	0b0010

## SUB	(R1, A)
MOV	@0x1000 0b0010
MOV	AL		0b0001

SUB AL		@0x1000

## SUB	(A, C)
MOV	@0x1000 0b0011

SUB	@0x1000 0b0001

## SUB	(A, R1)
MOV	@0x1000 1
MOV	AL		2

SUB @0x1000 AL

## SUB	(R1, R1)
MOV	AL	0x11
MOV	AH	0x01

SUB	AL	AH

## SUB	(A, A)
MOV	@0x1000	0x12
MOV	@0x1001	0x01

SUB	@0x1000 @0x1001

HLT